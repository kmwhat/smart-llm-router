#!/bin/sh
set -eu

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
PROJECT_ROOT=$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd)
STATE_HOME=${XDG_STATE_HOME:-"$HOME/.local/state"}
PERSISTENT_RUNTIME="$STATE_HOME/smart-llm-router"
if [ -z "${SMART_LLM_RUNTIME_DIR:-}" ]; then
  if mkdir -p "$PERSISTENT_RUNTIME" 2>/dev/null && [ -w "$PERSISTENT_RUNTIME" ]; then
    export SMART_LLM_RUNTIME_DIR="$PERSISTENT_RUNTIME"
    export SMART_LLM_RUNTIME_DIR_SOURCE="persistent_user_state"
  else
    export SMART_LLM_RUNTIME_DIR="${TMPDIR:-/tmp}/smart-llm-router-runtime"
    export SMART_LLM_RUNTIME_DIR_SOURCE="temporary_fallback"
    export SMART_LLM_RUNTIME_FALLBACK_REASON="persistent_runtime_unwritable"
    export SMART_LLM_RUNTIME_EXPECTED_DIR="$PERSISTENT_RUNTIME"
  fi
elif [ -z "${SMART_LLM_RUNTIME_DIR_SOURCE:-}" ]; then
  export SMART_LLM_RUNTIME_DIR_SOURCE="explicit_environment"
fi

PYTHON_BIN=${SMART_LLM_PYTHON:-"$PROJECT_ROOT/.venv/bin/python"}
if [ ! -x "$PYTHON_BIN" ]; then
  PYTHON_BIN=$(command -v python3)
fi

ENV_FILE=${SMART_LLM_ENV_FILE:-"$PROJECT_ROOT/.env"}

exec "$PYTHON_BIN" \
  -I \
  -c '
import runpy
import sys

project_root = sys.argv.pop(1)
sys.path.insert(0, project_root)
sys.argv[0] = "smart-llm-router"
runpy.run_module("smart_llm_router.cli", run_name="__main__")
' \
  "$PROJECT_ROOT" \
  --env-file "$ENV_FILE" \
  "$@"
