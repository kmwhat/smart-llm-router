{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Independent source audit verdict",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "verdict": {
      "type": "string",
      "enum": ["ACCEPT", "REPAIR_REQUIRED", "REVOKE"]
    },
    "release_blocker": {
      "type": "boolean"
    },
    "findings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 240
      }
    },
    "confidence": {
      "type": "string",
      "enum": ["high", "medium", "low"]
    }
  },
  "required": ["verdict", "release_blocker", "findings", "confidence"]
}
